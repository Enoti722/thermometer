<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- mipmap/ic_launcher created with Android Studio -> New -> Image Asset using @color/colorPrimary and USB clip art -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Скорость по GPS из foreground service: обязательно с Android 14 при типе location -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Для определения реального приложения поверх экрана (см. UsbService.getForegroundApp); доступ выдаётся вручную в «Доступ к данным об использовании» -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.hardware.usb.host" />
    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Показывает диалог исключения из оптимизации батареи (открывает системный UI, автоматической выдачи нет). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:icon="@mipmap/ic_launcher_logo"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        tools:ignore="AllowBackup,GoogleAppIndexingWarning">

        <service
            android:name=".UsbService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|location" />

        <receiver
            android:name=".BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <!-- Intent доставится только если action объявлен в фильтрах. Свои OEM-бродкасты добавьте отдельным intent-filter. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <!-- Некоторые прошивки шлют альтернативное событие «быстрой» загрузки -->
            <intent-filter>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <!-- Косвенные признаки «питается / включение ГУ». Значение константы см. Intent.ACTION_* в API. -->
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
            <!-- Время системы -->
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <!-- Одна диагностическая строка из BootCompletedReceiver на процесс; шум режется в коде -->
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_ON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
            <!-- Первый init пользователя; на телефонах часто недоступен приложениям без привилегий, но магнитола может передать иначе. -->
            <intent-filter>
                <action android:name="android.intent.action.USER_INITIALIZE" />
            </intent-filter>
        </receiver>

        <!-- for this simple app launchMode=singleTask and singleTop have same effect.
             If you would start another activity in the app, e.g. Android Settings
             then you should use singleTask, else a new MainActivity would be started
             when the settings activity is currently shown -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity
            android:name=".SpeedEmulationActivity"
            android:label="@string/speed_emulation_title"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ConfiguredAppsListActivity"
            android:label="@string/apps_settings_activity_title"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".AllAppsListActivity"
            android:label="Выбрать приложение"
            android:parentActivityName=".ConfiguredAppsListActivity"
            android:exported="false" />

        <activity
            android:name=".AppSpecificSettingsActivity"
            android:label="Настройки приложения"
            android:parentActivityName=".ConfiguredAppsListActivity"
            android:exported="false" />

        <activity
            android:name=".SystemSettingsActivity"
            android:label="@string/system_settings_activity_title"
            android:parentActivityName=".MainActivity"
            android:exported="false" />
    </application>
</manifest>
